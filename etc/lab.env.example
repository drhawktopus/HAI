# The lab tools' settings. Copy to lab.env beside this file and fill it in; the environment wins over the file.
# A value that is a table is JSON. Names such as box-1 stand for your own machines' names.

# The head's address, for example http://<head-address>:8099. The reporters and deploy tools talk to it; empty = not linked.
HAI_URL=http://<address>:<port>

# The head's ssh name: the box that runs the head's compose stack.
HEAD_NAME=head

# name -> address of every box a tool may address.
FLEET_HOSTS={"box-1": "<address>", "box-2": "<address>", "box-3": "<address>"}

# name -> the kind of box, for the reachability probe (probe.py).
HOST_CLASSES={"box-1": "gpu", "box-2": "gpu", "box-3": "gpu"}

# name -> address of devices the reachability probe also checks (a router, a DNS server).
APPLIANCE_HOSTS={"dns-server": "<address>"}

# Your DNS server's address; the update stager checks it answers before and after an update.
PIHOLE_ADDRESS=<address>

# Your LAN's first three octets, for example 192.168.1.
LAN_PREFIX=<address>

# The head's port (default 8099).
ORCH_PORT=8099

# The model servers' port (default 11434).
OLLAMA_PORT=11434

# The shared staging folder as the GPU boxes name it (a UNC path).
SSD_SHARED_UNC=<path>

# The folder of Strata's serving plans, as the box that runs Strata names it. Unset = the menu filler orders no Strata
# arm.
STRATA_PLANS_DIR=<path>

# The large shared folder as the GPU boxes name it (a UNC path), for the share credential tool.
BIG_SHARED_UNC=<path>

# The ssh names run_remote.py may run a root script on, comma-separated.
RUN_REMOTE_HOSTS=tablet-head,box-4

# The file holding the sudo credentials run_remote.py passes to those hosts. Keep it private.
LAB_CREDENTIAL_LOCKER=<path>

# name -> the ssh names to try for it, in order (sshto.py).
SSHTO_CANDIDATES={"tablet-head": ["<address>", "<address>"], "box-4": ["<address>"]}

# The order the update stager updates boxes in.
STAGE_ORDER=["box-2", "box-3"]

# The order the update stager updates GPU drivers in.
DRIVER_ORDER=["box-2", "box-3"]

# box -> the scheduled task that runs its factory, for the update stager to pause and resume.
BOX_RUNNERS={"box-1": "<value>", "box-2": "<value>", "box-3": "<value>"}

# box -> its factory's state folder, for the update stager.
BOX_STATE_DIRS={"box-1": "<path>", "box-2": "<path>", "box-3": "<path>"}

# The tablets' ssh private key, for the lab tools that reach a tablet.
TABLET_SSH_KEY=<path>

# The cameras' NVR's address, for the cameras lane.
NVR_HOST=<address>

# The camera credentials document (a markdown table with Username and Password rows, the NVR's first; NVR_USER and NVR_PASSWORD in the environment take precedence). Keep it private.
CAMERA_CRED_DOC=<path>

# The cameras site the cameras lane publishes its frames and timeline to.
CAMERAS_SITE_URL=http://<address>:<port>

# The NVR's own web pages, linked from the cameras site (default http://<NVR_HOST>/).
NVR_SITE_URL=http://<address>:<port>

# The box that runs a media server the update stager must not restart under a stream (empty = none).
PLEX_BOX=box-3

# Boxes that install only Windows updates already proven on another box.
PROVEN_KBS_ONLY=["box-1"]

# The box with an AMD card, whose driver updates are staged separately.
AMD_DRIVER_BOX=box-1

# box -> NVIDIA's product id for its card, to look up its current driver.
NVIDIA_PFID={"box-2": "<value>", "box-3": "<value>"}

# box -> a scheduled task to run after its updates install.
POST_INSTALL_TASK={"box-2": "<value>", "box-3": "<value>"}

# box -> the scheduled task that installs its app updates.
APPS_VIA_TASK={"box-2": {"pythonw": "<path>"}}

# The menu wall's boxes: where each writes its telemetry and the python that reads it there.
WALL_BOXES={"box-1": {"python": "<path>", "files": ["<path>", "<path>"], "parse": "<value>"}, "box-2": {"python": "<path>", "glob": "<path>", "since": "<value>", "parse": "<value>", "ups_w_per_pct": 4.5}, "box-3": {"local": true, "parse": "<value>", "ups_w_per_pct": 9.0, "subtract_tablet_head": true}}

# This box's own telemetry folder, for the menu wall.
WALL_LOCAL_TELEMETRY=<path>

# box -> where its model server writes its log (live_rate.py).
ENGINE_SERVE_LOGS={"box-1": "<path>", "box-2": "<path>", "box-3": "<path>"}

# The head's compose stack folder, on the head.
HEAD_STACK_DIR=<path>

# The documentation library's folder as the head mounts it.
HEAD_DOCS_MOUNT=<path>

# The tablet head's ssh name.
TABLET_HEAD_NAME=tablet-head

# The library's State folder, as this box sees it.
DOCS_STATE_DIR=<path>

# component -> its source folder on this box (orchestrator, foundry, tolkien, lab, menu).
CODE_MIRRORS={"orchestrator": "<path>", "foundry": "<path>", "tolkien": "<path>", "lab": "<path>"}

# The lab's model-engine folder (its builds and patches).
LAB_ENGINE_DIR=<path>

# The folder of patches applied to the model engine's source.
ENGINE_PATCHES_DIR=<path>

# The folder campaign orders are written to.
CAMPAIGNS_DIR=<path>

# box -> how to ask its model engine its version.
ENGINE_PROBES={"box-2": ["<value>", "<value>"], "box-3": ["<value>", "<value>"]}

# The factory whose compute order builds the model engine (its fleet name).
ENGINE_BUILD_BOX=box-1

# The GPU factories the engine rolls out to, in order, the canary first (comma-separated fleet names). Unset = the
# engine pipeline holds and says so.
ENGINE_ROLLOUT=box-2,box-3,box-1

# This box's own factory folder.
LOCAL_FOUNDRY_ROOT=<path>

# The model engine's folder on the tablet head.
TABLET_HEAD_ENGINE_TREE=<path>

# The path prefix the tablet head archives an old engine build under.
TABLET_HEAD_ENGINE_ARCHIVE_PREFIX=<path>

# The upstream releases the update system watches.
UPSTREAM_WATCH={"ollama/ollama": "<value>", "comfyanonymous/ComfyUI": "<value>", "mostlygeek/llama-swap": "<value>"}

# The upstream repositories whose new commits the update system reports.
UPSTREAM_COMMITS_WATCH={"ostris/ai-toolkit": "<value>"}

# The adb binary (default adb on the path).
ADB_EXE=<path>

# The tablets' order share, as this box sees it.
TABLET_JOBS_HOST=<path>

# The same share, as Tolkien sees it.
TABLET_JOBS_SEEN=<path>

# The priced menu's products folder.
MENU_DIR=<path>

# The tablet gauntlet's results file, for the menu.
GAUNTLET_CSV=<path>

# The library's State folder by a path every account on this box can read.
DOCS_STATE_LOCAL=<path>

# The vision test set's folder, for the menu.
VLM_HARD_SET_DIR=<path>

# The tablet head's compose stack folder, on the tablet head.
TABLET_HEAD_STACK_DIR=<path>

# The model engine's git checkouts on the tablet head, comma-separated, for the update inventory.
TABLET_HEAD_ENGINE_GIT_TREES=<path>

# The owner's profile name: the profile the tools act as.
OWNER_USER=<value>

# The Fellowship roster file (fellowship/roster.example.json shows its shape).
FELLOWSHIP_ROSTER=<path>

# The tablets' USB segment, its first three octets (default 10.55.0).
FELLOWSHIP_USB_SEGMENT=<address>

# The documentation library's root folder, as this box sees it.
LIBRARY_ROOT=<path>

# The off-box watchdog's folder on the box that watches the head: its state and its log.
KIRK_WATCHDOG_HOME=<path>

# The watchdog's own ssh key for the head (only the watchdog uses it). Keep it private.
KIRK_WATCHDOG_KEY=<path>

# user@host the watchdog reaches the head as, to tag and roll back the head's image.
KIRK_WATCHDOG_SSH_TARGET=<value>
# The heavy box's name in FLEET_HOSTS (the evals' context gate reads its model server).
HEAVY_BOX_NAME=heavy-box
# The Linux boxes the update inventory reads (comma list); unset = the head and the tablet head.
UPDATE_INVENTORY_LINUX=
# The tablet the camera tools run ffmpeg and ffprobe on (its name in the roster).
CAMERAS_FFMPEG_NODE=<a tablet's name>
