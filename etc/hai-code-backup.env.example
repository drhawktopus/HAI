# The weekly code backup's settings (install_hai_code_backup.sh <this file>, on the head, as root). Copy to
# hai-code-backup.env beside this file and fill it in.
# The share holding the code repos, as the head mounts it (a mount point).
HAI_BACKUP_SRC=<mount point>
# The PRIVATE git repo the history-free snapshot is force-pushed to (branch backup).
HAI_BACKUP_REMOTE=https://github.com/<owner>/<private repo>.git
# The repo folders under the share, space-separated, quoted.
HAI_BACKUP_REPOS="<repo> <repo>"
# Optional: "<git checkout>:<folder>" pairs archived from another checkout, each without its data/ folder.
HAI_BACKUP_EXTRA=
# Optional: a credential locker whose values refuse the push (read with the lab's publish tools).
HAI_BACKUP_LOCKER=
# The account the backup runs as; its `gh auth` login does the push.
HAI_BACKUP_USER=<account>
# When, as a systemd OnCalendar value with its time zone.
HAI_BACKUP_WHEN=Sun *-*-* 05:30:00 <time zone>
