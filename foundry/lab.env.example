# The foundry's settings: <root>\etc\lab.env on each factory, and on the head for its deploy doors. setup_factory writes
# a factory's own (FOUNDRY_ROOT, FOUNDRY_FLEET_HOST, HAI_URL, OLLAMA_PORT and any --set); the environment wins over the
# file. A value that is a table is JSON. Names such as box-1 stand for your own machines' fleet names. A setting left
# unset turns its feature off or makes the tool refuse, naming the setting; nothing falls back to another lab's box.

# ---- every factory -------------------------------------------------------------------------------------------------

# The factory's folder (bin, etc, var, jobs).
FOUNDRY_ROOT=<path>

# Its fleet name, as the head and the fleet know it. Unset = the machine's own hostname, lowercased.
FOUNDRY_FLEET_HOST=box-1

# The head, for example http://<head-address>:8099. Empty = not linked: the factory works from its own queue.
HAI_URL=http://<address>:<port>

# Ollama's port on this box.
OLLAMA_PORT=11434

# ---- per factory, optional (factory_role.json lists them; unset = the feature is off) ------------------------------

# The trainer's ai-toolkit tree; empty = this box trains nothing. Its Python (FOUNDRY_PY) defaults to the tree's venv.
FOUNDRY_AI_TOOLKIT=<path>
FOUNDRY_PY=<path>

# The ComfyUI launcher; empty = this box renders nothing. Its loras and output folders default to ComfyUI's own.
FOUNDRY_COMFY_LAUNCH=<path>
FOUNDRY_LORAS=<path>
FOUNDRY_COMFY_OUTPUT=<path>

# The render model's file for this card (a smaller quant on a smaller card).
FOUNDRY_RENDER_UNET=<file>

# The card's standing clock policy (clock_policy.py): a lock at N MHz, or a band from a floor to a ceiling. None set =
# the card runs at its own boost and nothing touches it.
FOUNDRY_TARGET_CLOCK=<mhz>
FOUNDRY_CLOCK_FLOOR=<mhz>
FOUNDRY_CLOCK_CEILING=<mhz>

# A card that needs a power cap, in watts: set again at startup and every 15 minutes (a driver reset clears it).
FOUNDRY_GPU_POWER_LIMIT_W=<watts>

# 1 where a USB UPS feeds this box: the whole box's power is logged, so an order's energy counts the CPU too.
FOUNDRY_UPS_LOGGER=1

# Ollama's default window on this box (keeps a model resident on a small card).
OLLAMA_CONTEXT_LENGTH=<tokens>

# 1 on a box that shares its card with a media server: one model at a time, and an unreadable VRAM status fails closed.
FOUNDRY_PLEX_MODEL_GUARD=0

# The sensor library for the telemetry logger; unset = LHM\ beside the logger script.
FOUNDRY_LHM_DLL=<path>

# llama-swap's folder (the on-demand server in workspace\flashnext).
LLAMA_SWAP_DIR=<path>

# The message relay for the owner's notices (the head's DM relay) and the box it runs on; empty = nothing is sent.
OVERNIGHT_DM_URL=http://<address>:<port>
OVERNIGHT_DM_HOST=<name>

# The dataset builder's default box for its captioning fleet (a fleet name).
P20_FLEET_HOST=box-1

# The shared staging folder as this box names it, and the same share as the head's container sees it.
SSD_SHARED_UNC=\\<address>\<share>
SSD_SHARE_MOUNT=<path>

# The library's network share (a mapped drive is per-logon, so tools use the UNC).
BIG_SHARED_UNC=\\<address>\<share>

# The LAN's address prefix, for example 192.0.2. ; unset = no LAN is configured.
LAN_PREFIX=<prefix>

# The owner's user name in the head's history.
OWNER_USER=owner

# The head's history folder as this box sees it; empty = none here.
HAI_HISTORY_DIR=<path>

# The update inventory's extra engine trees (semicolon-separated), and the parent folder of the Flash-Next builds.
UPDATE_INVENTORY_ROOTS=<path>;<path>
FLASHNEXT_PARENT=<path>

# ---- the head's deploy doors (only on the box you deploy from) -----------------------------------------------------

# The GPU factories: name -> its root, the scheduled task that owns its runner, and the one that owns its render worker.
FLEET_TABLE={"box-1": {"root": "<path>", "task": "<task name>", "worker_task": "<task name>"}, "box-2": {"root": "<path>", "task": "<task name>", "worker_task": "<task name>"}}

# name -> address of every box a tool may address.
FLEET_HOSTS={"box-1": "<address>", "box-2": "<address>"}

# Files that run outside <root>\bin: file -> {box: the folder it runs from there}. Each goes to the boxes it names only
# (a launcher in the lab repository's hosts\<box>\launchers\ goes to that box's folder here).
FLEET_ELSEWHERE={"<file>": {"box-1": "<folder>"}}

# The engine door: box -> its card family ("nvidia" or "amd"), box -> the script that starts its ollama, where a build
# is staged, and the boxes whose ollama starts as the console user (Windows asks to allow a new program through the
# firewall there; the deploy waits for that click instead of switching).
FLEET_ENGINE_SETS={"box-1": "nvidia", "box-2": "amd"}
FLEET_ENGINE_LAUNCHERS={"box-1": "<path>", "box-2": "<path>"}
FLEET_ENGINE_STAGE=<path>
FLEET_CONSOLE_LAUNCH=["box-2"]

# component -> its source folder on this box (orchestrator, foundry, tolkien, lab), and the lab tools' folder.
CODE_MIRRORS={"orchestrator": "<path>", "foundry": "<path>", "tolkien": "<path>", "lab": "<path>"}
LAB_TOOLS_DIR=<path>

# The head's ssh name, and its compose stack folder there.
HAI_BOX_NAME=head
HEAD_STACK_DIR=<path>

# The A1 payload's source folder here, and the menu machinery's folder (the A1 dev trees).
A1_SRC=<path>
HARD_BENCH_DIR=<path>

# The tablet head: its ssh name; the order inbox and the A1 payload folder as this box sees them, and that folder as
# Tolkien's own mount names it. Unset = no tablet head: its doors refuse, naming the setting.
TABLET_HEAD_NAME=tablet-head
TABLET_INBOX_HOST=<path>
TABLET_A1_PAYLOAD_HOST=<path>
TABLET_A1_PAYLOAD_SEEN=<path>

# The GPU factory whose running copy a file shared with Tolkien must equal (default: the fleet table's first box).
FOUNDRY_SHARED_SOURCE_BOX=box-1

# The tablet head's engine: its mounted engine folder, its in-place build tree (%s = the build's tag), and the prefix of
# its archived builds.
RIGBY_ENGINE_DIR=<path>
RIGBY_BUILD_DIR=<path>
RIGBY_ENGINE_ARCHIVE_PREFIX=<path>

# The library triage staging share (as the head names it), and a port known to be closed (the verify lane's negative
# control).
LIBRARY_STAGE_UNC=\\<address>\<share>
GOLD_CLOSED_PORT=<port>
