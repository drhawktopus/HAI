# The Discord relay's settings (the hawkadminbot service). Copy to relay.env, fill it in, and keep it to yourself (it
# holds the bot's token): chmod 600 relay.env on Linux. Start the relay with: docker compose --profile discord up -d
# house/discord-relay/README.md has the Discord side (making the bot and inviting it).

# The bot's token, from the Discord developer portal. Unset = the bot logs a warning and exits.
DISCORD_TOKEN=<the bot's token>

# The shared token HAI sends with each DM request: any long random value, the SAME one the head's dm_token file holds.
# Unset = the relay sends no DMs.
DM_TOKEN=<a long random value>

# Who may approve contributions and run the admin commands (space- or comma-separated Discord user ids). Anyone with
# Manage Server or Administrator in your server also qualifies.
ADMIN_DISCORD_IDS=<your Discord user id>

# The channel the contribution cards are posted to. 0 = no posting (the /contributions command still works).
CONTRIB_CHANNEL_ID=0

# Your server's id, so the slash commands appear at once. Empty = global sync (up to an hour).
GUILD_IDS=

# The HAI profile whose pending contributions it posts: your OWNER_USER.
HAI_ADMIN_USER=<your name>

# Optional: a Plex server to watch, and the channel its status goes to (0 = off).
# PLEX_CHECK_URL=http://<plex address>:32400/identity
# PLEX_STATUS_CHANNEL_ID=0

# Your time zone (an IANA name).
TZ=UTC
