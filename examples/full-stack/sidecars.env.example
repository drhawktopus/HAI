# Settings the full stack adds to the head's settings.env. Copy to sidecars.env. The head, the coding runner, the
# host-ops broker and the wake-on-LAN sidecar read it. Tokens are files under state/secrets/, never values here.

# The coding runner.
CODING_RUNNER_URL=http://coding-runner:8100
CODING_RUNNER_TOKEN_FILE=/run/secrets/coding_runner_token

# The host-ops broker, and the containers it never stops or recreates on request.
HOSTOPS_URL=http://hostops:9120
HOSTOPS_TOKEN_FILE=/run/secrets/hostops_token
HOSTOPS_PROTECTED=hostops,hai

# The compose project and network a broker's one-off containers join: this stack is named hai-stack, so its network
# is hai-stack_hai.
DEPLOY_COMPOSE_PROJECT=hai-stack
DEPLOY_COMPOSE_NETWORK=hai-stack_hai
HOSTOPS_ONEOFF_NETWORK=hai-stack_hai

# Self-deploy: the live head and its canary by service name, how the canary is checked, and the identity its commit
# of the promoted source carries.
DEPLOY_LIVE_SERVICE=hai
DEPLOY_CANARY_SERVICE=hai-canary
DEPLOY_CANARY_HEALTH=http://hai-canary:8099/health
DEPLOY_CANARY_SMOKE=http://hai-canary:8099/modes
HOSTOPS_GIT_EMAIL=hai@localhost

# Web search.
SEARXNG_URL=http://searxng:8080

# Wake-on-LAN. The head reaches the host-network sidecar through the host; the sidecar broadcasts on these addresses
# (put your LAN's broadcast address first, for example 192.168.1.255, then the limited broadcast).
WOL_SIDECAR=http://host.docker.internal:9119
WOL_SIDECAR_BROADCASTS=255.255.255.255

# A tablet head (examples/tablet-head). The head and Tolkien hand work to each other through ONE folder that both
# machines mount (a network share): the head puts orders in its inbox and reads results from its outbox. The head sees
# it at /tabjobs (uncomment the volume line in docker-compose.yml); Tolkien sees the same folder at /jobs (its ./jobs
# mount). Paths the head writes INTO an order are Tolkien's view, so these name it:
# TABFOUNDRY_SHARE=/tabjobs
# TABFOUNDRY_SHARE_FOUNDRY=/jobs
# HAI_CHAT_WINDOWS_TOLKIEN=/jobs/chat-windows
# HAI_RENDER_JOBS_TOLKIEN=/jobs/renders

# The Discord relay (the hawkadminbot service, --profile discord; house/discord-relay/README.md): where HAI sends the
# notices it DMs to a person. Both tokens hold the SAME value as the relay's DM_TOKEN (in relay.env), each in its own
# file; the Discord user ids are the person who gets them. Unset = those notices are off.
# HAWKADMIN_DM_URL=http://hawkadminbot:8477/dm
# HAWKADMIN_DM_TOKEN_FILE=/run/secrets/dm_token
# ADMIN_DISCORD_ID=<your Discord user id>
# OVERNIGHT_DM_TOKEN_FILE=/run/secrets/dm_token
# OVERNIGHT_DM_USER_ID=<your Discord user id>
