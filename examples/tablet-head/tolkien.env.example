# Settings for Tolkien on the tablet head. Copy to tolkien.env. Tokens are files where a setting takes a file; the two
# that are values (P20_WORKER_TOKEN, HAWKADMIN_DM_TOKEN) belong only in this file, which stays on this machine.

# The head this factory is linked to, and the worker token the head's fleet desk accepts (the head's
# state/secrets/worker_token).
HAI_URL=http://<head-address>:8099
P20_WORKER_TOKEN=<the head's worker token>

# Where Tolkien keeps its state, and its order inbox and outbox (the folders mounted in docker-compose.yml).
TABLET_FOUNDRY_ROOT=/tabfoundry
TABLET_INBOX=/jobs/inbox
TABLET_OUTBOX=/jobs/outbox
# The share these two sit in (/jobs) also holds what Tolkien publishes for other desks (rigby-models.json, the GGUFs on
# this machine's disk; TOLKIEN_MODELS_MANIFEST names another file) and the engine files an order may name (payloads/).

# The tablets: name -> [address, adb serial]. The same tablets as the Fellowship roster (FELLOWSHIP_ROSTER); add a
# tablet to both.
TABLET_NET={"tablet-1": ["<tablet-1-address>", "<adb-serial>"], "tablet-2": ["<tablet-2-address>", "<adb-serial>"]}
# Each tablet's last address octet on the USB segment (the roster's usb_octet); with TABLET_WIRE_PREFIX it makes the
# tablet's wire address. Empty = no tablet has a wire address, and each is reached over WiFi.
TABLET_WIRE_OCTETS={"tablet-1": 11, "tablet-2": 12}
# Each tablet's hardware class, A, B or C (the roster's class): the class groups the controls act on and the model
# size each tablet is offered. Empty = no classes: no groups but "all", and each tablet gets the largest model that fits.
TABLET_CLASSES={"tablet-1": "A", "tablet-2": "B"}
# A tablet that runs its OWN lane for matrix orders over its class (to measure it apart from its peers); usually empty.
TABLET_SKU_LANES={}
# A suffix your DNS gives the tablets' names, if any (for example .lan); empty = use the addresses.
TABLET_DNS_SUFFIX=
# The tablet head's model stage server as the tablets reach it (a payload fetches a model it lacks from here); a
# tablet whose own environment sets FELLOW_STAGE_URL keeps its own. Empty = payloads cannot fetch a missing model.
TABLET_STAGE_URL=http://<tablet-head-address>:8078

# The tablets' ssh key and the fellows' shared token, as mounted.
TABLET_SSH_KEY=/run/secrets/tabcluster_key
TABLET_FELLOW_TOKEN_FILE=/run/secrets/fellow_token

# The watchdog's check over the USB segment: the user on this machine whose authorized_keys gives the watchdog's key
# the USB reach probe as a forced command (fellowship/install_usb_reach_probe.sh prints the line).
TABLET_WATCH_RIGBY_USER=<this machine's login user>
TABLET_WATCH_RIGBY_KEY=/run/secrets/tabcluster_key

# Notices: a Discord relay (house/discord-relay) and the person it messages. Leave empty for none.
HAWKADMIN_DM_URL=
HAWKADMIN_DM_TOKEN=
ADMIN_DISCORD_ID=

# The owner's profile name on the head, and the lab's wall clock (an IANA zone).
OWNER_USER=<the owner's profile name>
TZ=UTC
