# Uhura's settings on the machine that ships and tests it. Copy to deploy/uhura.env (git-ignored) and fill in.
UHURA_SSH_HOST=uhura-host
UHURA_HOME=/opt/uhura
UHURA_STACK_DIR=/opt/stack
UHURA_PUBLIC_URL=https://uhura.example.org
UHURA_DIRECT_URL=http://<uhura-host-address>:8478
# host:port pairs on your network the container must NOT reach (the network guard's live decoys)
UHURA_EGRESS_PROBES=
# the transcript publisher's sources (Claude Code's projects, the head's chat history, Codex's home)
UHURA_CLAUDE_PROJECTS=
UHURA_DOC_HISTORY=
UHURA_CODEX_HOME=
# The library the publishers read.
UHURA_LIBRARY=/path/to/the/library
