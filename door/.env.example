# The door's settings, read by docker-compose.yml and by Uhura. Copy to .env beside docker-compose.yml. It holds
# secrets: keep it private (mode 600) and out of git.

# The owner: the account Uhura answers to, by sign-in email, and the owner's profile name on the head.
UHURA_OWNER_EMAIL=<the owner's sign-in email>
UHURA_OWNER_NAME=<the owner's profile name>

# The door's public address, as the reverse proxy serves it.
UHURA_BASE_URL=https://<your door's host name>

# Google sign-in: an OAuth client of type "web application", with <UHURA_BASE_URL>/auth/callback as a redirect.
UHURA_GOOGLE_CLIENT_ID=<client id>
UHURA_GOOGLE_CLIENT_SECRET=<client secret>

# The key Uhura signs its session tokens with: a random value of your own.
UHURA_JWT_KEY=<random value>

# A Discord webhook for the door's notices (empty = none).
UHURA_DISCORD_WEBHOOK=

# The liaison on the head (examples/full-stack, --profile door): its host, its address, and the secret both share
# (the same value as UHURA_LIAISON_SECRET in the head's door.env).
UHURA_LIAISON_HOST=<head address>
UHURA_LIAISON_URL=http://<head address>:8479
UHURA_LIAISON_SECRET=<random value>

# An address on your LAN the door must NOT reach (host:port). The network guard refuses private ranges; Uhura refuses
# to start, and exits later, if this address ever answers, so a lost firewall fails loudly.
UHURA_EGRESS_CANARY=<head address>:22

# The folder of published, filtered transcripts (deploy/publish_transcripts.py writes it).
UHURA_TRANSCRIPTS_DIR=/path/to/uhura-transcripts
